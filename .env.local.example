NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Solana
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=[1,2,3,...]

# Helius (used for on-chain RPC calls requiring getProgramAccounts)
# Agent sync uses the public 8004 indexer by default (no key needed)
# Provide Helius URL if you want on-chain fallback or future direct RPC calls
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# App URL (set on production / Vercel, defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=https://vouch-solana.vercel.app

# Optional AI Judge Fallback (defaults to deterministic on-chain ground truth verification)
# ANTHROPIC_API_KEY=your-anthropic-key

# 8004 Indexer — optional override (defaults to public devnet/mainnet indexers)
# INDEXER_URL=https://8004-indexer-dev.qnt.sh/rest/v1

# Sync route protection — optional, leave blank for open access in dev
# SYNC_SECRET=your-secret-here
